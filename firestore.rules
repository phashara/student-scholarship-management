rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'phasharak@gmail.com';
    }

    // Full applications contain identity, contact, family, financial, and
    // uploaded document data. Only the named, verified administrator may read
    // or mutate these documents. Public submissions go through a callable.
    match /scholarship_applications/{applicationId} {
      allow read, write: if isAdmin();
    }

    // Public list is a deliberately minimized projection maintained by a
    // server-side trigger. It never contains IDs, contact data, or documents.
    match /public_applications/{applicationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system_metadata/{documentId} {
      allow read, write: if isAdmin();
    }

    match /timeline_configs/{configId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
